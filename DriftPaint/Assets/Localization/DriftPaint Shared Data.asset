      m_Items: []
  - m_Id: 851267930918928
    m_Key: "{0} abandon\xF3 la partida"
    m_Metadata:
      m_Items: []
  - m_Id: 851267930918929
    m_Key: "{0} no volvi\xF3 a tiempo"
    m_Metadata:
      m_Items: []
  - m_Id: 851267930918930
    m_Key: '{0} es ahora el host'
    m_Metadata:
      m_Items: []
  - m_Id: 851267930918931
    m_Key: "Se perdi\xF3 la conexi\xF3n. Reconectando..."
    m_Metadata:
      m_Items: []
  - m_Id: 851267930918932
    m_Key: Volviste a la partida
    m_Metadata:
      m_Items: []
  - m_Id: 851267930918933
    m_Key: '{0} es ahora el MVP'
    m_Metadata:
      m_Items: []
