  m_Script: {fileID: 11500000, guid: 0babd94d2d9af8d46a1461effc1fb9f7, type: 3}
  m_Name: Map_Graffithasia
  m_EditorClassIdentifier: DriftPaint.Gameplay::DriftPaint.Match.MapDefinitionSO
  _mapId: graffithasia
  _thumbnail: {fileID: 21300000, guid: e37fcfeb55a6df643be598c4610b796b, type: 3}
  _loadingBackground: {fileID: 21300000, guid: 936051bae035ad747a4cdf0b136717a0, type: 3}
  _tagline: "Cubr\xED la arena con tu color antes de que se acabe el tiempo."
  _steps:
  - image: {fileID: 21300000, guid: 3cdf2daf0ea1c344aa737b5e25c31506, type: 3}
    title: "PINT\xC1 EL PISO"
    body: "Tu auto pinta todo lo que pisa. Pas\xE1 sobre la pintura rival para robarla."
  - image: {fileID: 21300000, guid: a38a8973da9b07548969ce1acc9f1a5a, type: 3}
    title: "US\xC1 LOS AROS"
    body: "Salt\xE1 desde la rampa y cruz\xE1 el aro para cargarlo. Cargado, gira
      y ba\xF1a la zona con tu color. Si lo cruza el rival, le quita una carga."
  - image: {fileID: 21300000, guid: ed964e7b1c32e134ea03b0333745087f, type: 3}
    title: "GAN\xC1 EL TERRITORIO"
    body: "Al terminar el tiempo gana el equipo con m\xE1s piso pintado. Si empatan,
      hay desempate."
  _tips:
  - "Cuid\xE1 tus aros: cada rival que los cruza les quita una carga."
  _minimumSeconds: 14
  _maximumWaitSeconds: 20
